<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Bonfire.Views.Contacts"
    Title="Контакты">

    <Grid>
        <CollectionView x:Name="PeersView"
                        ItemsSource="{Binding Peers}"
                        SelectionMode="Single"
                        SelectionChanged="OnPeerSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="16,12" Spacing="4">
                        <Label Text="{Binding DisplayName}" FontSize="16" />
                        <Label Text="{Binding PeerId}" FontSize="10" TextColor="Gray" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="EmptyLabel"
               Text="Пока никого не нашли"
               TextColor="Gray"
               FontSize="14"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               IsVisible="False"/>
    </Grid>

</ContentPage>