<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bonfire.Views.Chat">

    <Grid RowDefinitions="*, Auto" Padding="10" RowSpacing="8">

        <CollectionView Grid.Row="0"
                        x:Name="MessagesView"
                        ItemsSource="{Binding Messages}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,4">
                        <Border BackgroundColor="{Binding BubbleColor}"
                                StrokeThickness="0"
                                Padding="10"
                                HorizontalOptions="{Binding Alignment}"
                                MaximumWidthRequest="280">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Text}"
                                       FontSize="15"
                                       TextColor="{Binding TextColor}"/>
                                <Label Text="{Binding Time}"
                                       FontSize="10"
                                       TextColor="Gray"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="8">
            <Entry x:Name="MessageEntry"
                   Grid.Column="0"
                   Placeholder="Сообщение..."
                   Completed="OnSendClicked"/>
            <Button Text="Отправить"
                    Grid.Column="1"
                    BackgroundColor="#FF5722"
                    TextColor="White"
                    CornerRadius="8"
                    Clicked="OnSendClicked"/>
        </Grid>

    </Grid>
</ContentPage>